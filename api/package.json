{
  "name": "api-tareas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "dev": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env up -d",
    "db:down": "docker compose --env-file .env down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/error": "^4.2.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
